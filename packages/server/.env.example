# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/a11y-crawler.db

# CORS - Allowed client origins (comma-separated)
CLIENT_URL=http://localhost:5173,https://wcag.thegridbase.com

# Google Identity Services OAuth Web Client ID (not the client secret)
GOOGLE_CLIENT_ID=

# Exact, comma-separated verified Google emails that receive the admin role
ADMIN_EMAILS=cankilic.mail@gmail.com
